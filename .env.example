
DATABASE_URL=postgres://postgres:postgres@localhost:5432/utsavevents
DATABASE_SSL=

# Set to "false" on production deploys so a fresh prod database only seeds the
# real venue (Dr. Babu Jagajeevanram Bhavan Auditorium), not the demo events.
SEED_DEMO_EVENTS=

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=
# The site's own public URL — used for OG/share-preview links (WhatsApp, etc.)
# and email links. Falls back to https://utsavevents.live in code if unset.
NEXT_PUBLIC_BASE_URL=https://utsavevents.live

# Resend (https://resend.com) — transactional email for OTPs + ticket emails.
# Sign up, create an API key, and optionally verify a sending domain at
# https://resend.com/domains. Without a verified domain, EMAIL_FROM must stay
# on Resend's shared onboarding@resend.dev address (their sandbox sender).
RESEND_API_KEY=
EMAIL_FROM="Event Bookings <onboarding@resend.dev>"

ADMIN_EMAIL=utsavevents.tech@gmail.com
ADMIN_PASSWORD=change_me

CONTACT_EMAIL=contact@utsavevents.live

# REQUIRED IN PRODUCTION — signs session cookies + hashes OTPs. Must be a random
# value ≥16 chars (the app refuses to start in prod without it). Generate with:
#   openssl rand -hex 32
# AUTH_SESSION_SECRET is used for customer + OTP; ADMIN_SESSION_SECRET for admin
# (either alone is accepted). Set at least one to a strong random value.
AUTH_SESSION_SECRET=
ADMIN_SESSION_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WhatsApp ticket delivery — Meta's WhatsApp Cloud API (Graph API) directly,
# not a third-party wrapper. Get PHONE_ID + ACCESS_TOKEN from Meta Business
# Manager > WhatsApp Manager > API Setup for the connected business number.
# TEMPLATE_NAME must be an APPROVED template (default "utsav_qr") with a
# dynamic image header + 4 body variables (attendee name, event, seat,
# ticket id) — see lib/notifications/whatsapp.ts if the approved template's
# shape differs. Without these set, sends are logged to the console instead.
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_TEMPLATE_NAME=utsav_qr

# Cloudinary (optional) — enables direct image uploads from the admin panel;
# images are served from Cloudinary's CDN. Get these from
# https://console.cloudinary.com/settings/api-keys
# Without them, admins can still paste image URLs (Cloudinary/Drive links).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp alerts (optional) — sent on warn/error logs via CallMeBot
# (https://www.callmebot.com/blog/free-api-whatsapp-messages/).
# 1. Save +34 644 59 71 67 as a contact and message it on WhatsApp:
#    "I allow callmebot to send me messages"
# 2. CallMeBot replies with your personal API key — put it below.
WHATSAPP_ALERT_PHONE=
CALLMEBOT_API_KEY=

# Email alerts (optional) — sent on warn/error logs via Resend (reuses
# RESEND_API_KEY/EMAIL_FROM above). Falls back to ADMIN_EMAIL if unset.
LOG_ALERT_EMAIL=

# Deployment success/failure notifications (optional) — emailed via
# /api/webhooks/deploy/{vercel,railway}. Create a webhook in each platform's
# dashboard pointing at those URLs; each gives you a signing secret below.
VERCEL_WEBHOOK_SECRET=
RAILWAY_WEBHOOK_SECRET=

