# Postgres connection string. Locally: postgres://user:pass@localhost:5432/utsavevents
# Hosted (Neon/Supabase/Railway/RDS): use the connection string they give you
# and set DATABASE_SSL=true below if it requires TLS.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/utsavevents
# Set to "true" for hosted Postgres providers that require SSL.
DATABASE_SSL=

# Razorpay test-mode credentials — get them from
# https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Test keys start with rzp_test_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# Razorpay webhook (recommended) — the authoritative payment signal.
# Dashboard → Settings → Webhooks → add <your-domain>/api/webhooks/razorpay
# subscribing to payment.captured, payment.failed, refund.processed,
# and paste the same secret here.
RAZORPAY_WEBHOOK_SECRET=
# Public base URL used in webhook-triggered ticket emails (falls back to the
# request origin when unset).
NEXT_PUBLIC_BASE_URL=

# SMTP for ticket emails (optional — bookings still work without it,
# the ticket + QR are always shown on screen).
# Gmail: host smtp.gmail.com, port 587, user = your address,
# pass = an App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=utsavevents.tech@gmail.com
SMTP_PASS=your_app_password
# Optional pretty From header; defaults to SMTP_USER
EMAIL_FROM="Event Bookings <utsavevents.tech@gmail.com>"

# Bootstrap the FIRST admin account (a Super Admin) the first time the store
# initializes. Once any admin user exists, these are no longer read — manage
# accounts (including this one) from /admin/users instead.
ADMIN_EMAIL=utsavevents.tech@gmail.com
ADMIN_PASSWORD=change_me
# Optional dedicated secret for signing admin session cookies;
# falls back to ADMIN_PASSWORD when unset.
ADMIN_SESSION_SECRET=

# Secret for signing customer session cookies and OTP hashes.
# Falls back to ADMIN_SESSION_SECRET / ADMIN_PASSWORD when unset — set a
# dedicated random value in production.
AUTH_SESSION_SECRET=

# Twilio (optional) — SMS delivery for phone-number OTPs. Without these,
# OTPs for phone numbers are printed to the SERVER console (dev only) so the
# login flow stays testable. Email OTPs use the SMTP settings above.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Cloudinary (optional) — enables direct image uploads from the admin panel;
# images are served from Cloudinary's CDN. Get these from
# https://console.cloudinary.com/settings/api-keys
# Without them, admins can still paste image URLs (Cloudinary/Drive links).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

